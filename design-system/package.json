{
  "name": "@donel-dev/design-system",
  "version": "0.1.0",
  "description": "Design system do Donel Dev — cockpit desktop para operar sessões do Claude Code em paralelo.",
  "private": true,
  "type": "module",
  "main": "./dist/donel-design-system.cjs",
  "module": "./dist/donel-design-system.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/donel-design-system.js",
      "require": "./dist/donel-design-system.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build-storybook": "storybook build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.25.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.18",
    "typescript": "^5.7.3",
    "vite": "^5.4.20",
    "vite-plugin-dts": "^5.0.3"
  }
}
